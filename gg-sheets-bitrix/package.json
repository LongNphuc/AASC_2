{
  "name": "gg-sheets-bitrix",
  "version": "0.0.1",
  "description": "Đồng bộ danh sách khách hàng tiềm năng từ Google Sheets sang Bitrix24 Lead",
  "author": "LongNphuc",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "admin:install": "npm --prefix admin-ui ci",
    "admin:build": "npm --prefix admin-ui run build",
    "admin:dev": "npm --prefix admin-ui run dev",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/cli-data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/database/cli-data-source.ts migration:revert"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "google-auth-library": "^9.15.1",
    "libphonenumber-js": "^1.12.10",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!main.ts",
      "!**/*.module.ts",
      "!database/**",
      "!**/*.entity.ts",
      "!**/*.dto.ts",
      "!**/*.types.ts",
      "!config/swagger.ts",
      "!common/constants/**",
      "!testing/**"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "statements": 70,
        "functions": 70,
        "branches": 60
      }
    },
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/../test/setup-unit.ts"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
