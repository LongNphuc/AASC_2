      "put": {
        "description": "Kiểm từng đường dẫn và từng field trên portal trước khi lưu; sai thì 400 (20004/20006) kèm lỗi từng chỗ. version lệch thì 409 (20009).",
        "operationId": "ConfigController_putMappings",
        "parameters": [],
