    "/api/v1/leads": {
      "get": {
        "description": "Mỗi khách (nhận diện bằng email hoặc SĐT) kèm số lượt gửi, nguồn, lượt gửi mới nhất, số deal đang mở. Lọc theo kênh, campaign, ad, form, trạng thái, trạng thái đồng bộ, tìm theo tên/email/SĐT.",
        "operationId": "LeadsController_list",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "type": "number"
            }
          },
          {
            "name": "source",
            "required": false,
            "in": "query",
            "description": "Kênh khách đến",
            "schema": {
              "type": "string",
              "enum": [
                "tiktok",
                "facebook",
                "website"
              ]
            }
          },
          {
            "name": "campaign_id",
            "required": false,
            "in": "query",
            "description": "Khách có ít nhất một lượt gửi từ campaign này",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ad_id",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "form_id",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "new",
                "in_crm",
                "converted"
              ]
            }
          },
          {
            "name": "sync_status",
            "required": false,
            "in": "query",
            "description": "Khách có lượt gửi ở trạng thái này",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "synced",
                "failed"
              ]
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Tìm theo tên, email, SĐT",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date_range",
            "required": false,
            "in": "query",
            "description": "Theo lượt gửi gần nhất",
            "schema": {
              "type": "string",
              "enum": [
                "7d",
                "30d",
                "90d"
              ]
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "schema": {
              "example": "2026-10-01",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "schema": {
              "example": "2026-10-21",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Danh sách khách",
        "tags": [
          "Lead"
        ]
      }
    },
    "/api/v1/leads/{uuid}": {
      "get": {
        "description": "Kèm mọi lượt gửi (nguồn, câu trả lời, điểm, trạng thái đồng bộ, errorKbn) và deal.",
