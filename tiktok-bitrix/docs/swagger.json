{
  "openapi": "3.0.0",
  "paths": {
    "/webhooks/tiktok/leads": {
      "post": {
        "description": "Nhận lead.generate, form.complete, user.interaction. Kiểm TikTok-Signature trên raw body, lưu raw vào webhook_events, đẩy job, trả 200. Trùng event_id vẫn trả 200 (duplicate: true); sự kiện lạ lưu IGNORED.",
        "operationId": "TiktokWebhookController_receive",
        "parameters": [
          {
            "name": "tiktok-signature",
            "in": "header",
            "description": "t=<unix giây>,s=hex(HMAC_SHA256(TIKTOK_WEBHOOK_SECRET, \"<t>.<raw body>\")); lệch quá 300 giây bị từ chối",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {
                  "event": "lead.generate",
                  "event_id": "evt_1234567890",
                  "timestamp": 1709876543,
                  "advertiser_id": "7123456789",
                  "campaign": {
                    "campaign_id": "1234567890123456789",
                    "campaign_name": "Spring Sale 2024",
                    "ad_id": "9876543210987654321",
                    "ad_name": "Product Demo Video"
                  },
                  "form": {
                    "form_id": "form_abc123",
                    "form_name": "Contact Form"
                  },
                  "lead_data": {
                    "full_name": "Nguyễn Văn A",
                    "email": "nguyenvana@email.com",
                    "phone": "+84901234567",
                    "city": "Hà Nội",
                    "interests": [
                      "technology",
                      "mobile apps"
                    ],
                    "utm_source": "tiktok",
                    "utm_campaign": "spring_sale_2024",
                    "ttclid": "TT-abc123xyz789"
                  },
                  "custom_questions": [
                    {
                      "question": "Budget range",
                      "answer": "5-10 triệu VND"
                    },
                    {
                      "question": "Timeline",
                      "answer": "Trong 1 tháng"
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "received": true,
                    "eventId": "evt_1234567890"
                  }
                }
              }
            }
          }
        },
        "summary": "TikTok gửi sự kiện lead",
        "tags": [
          "Webhooks"
        ]
      }
    },
    "/webhooks/bitrix24/deals": {
      "post": {
        "description": "Webhook đi của Bitrix24 (form-urlencoded): event=ONCRMDEALUPDATE|ONCRMDEALDELETE, data[FIELDS][ID], auth[application_token]. Ứng dụng tự đọc deal qua API, không tin dữ liệu trong request.",
        "operationId": "BitrixWebhookController_receive",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "received": true
                  }
                }
              }
            }
          }
        },
        "summary": "Bitrix24 báo deal đổi stage hoặc bị xóa",
        "tags": [
          "Webhooks"
        ]
      }
    },
    "/api/v1/bitrix/lead-fields": {
      "get": {
        "description": "Mã, tên hiển thị, kiểu, bắt buộc không, chỉ đọc không của mọi field lead, kể cả custom field; dùng để viết mapping. Cache 10 phút.",
