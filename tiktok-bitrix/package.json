{
  "name": "tiktok-bitrix",
  "version": "0.0.1",
  "description": "Nhận lead từ TikTok Lead Generation, đồng bộ lên Bitrix24 CRM, chuyển thành deal theo rule, thống kê",
  "author": "LongNphuc",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "start:api": "nest start --watch --entryFile main",
    "start:worker": "nest start --watch --entryFile worker",
    "start:mock": "nest start --watch --entryFile mock-server",
    "start:prod": "node dist/main",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects e2e --runInBand",
    "migration:run": "ts-node src/scripts/migrate.ts",
    "migration:revert": "ts-node src/scripts/migrate.ts --revert",
    "tiktok:send": "ts-node src/scripts/send-tiktok-webhook.ts",
    "import:history": "ts-node src/scripts/import-history.ts",
    "seed:demo": "ts-node src/scripts/seed-demo.ts",
    "bitrix:setup": "ts-node src/scripts/bitrix-setup.ts",
    "swagger:export": "ts-node src/scripts/swagger-export.ts",
    "prepare": "cd .. && husky tiktok-bitrix/.husky || true"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.3",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "bullmq": "^6.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "libphonenumber-js": "^1.13.15",
    "pg": "^8.23.1",
    "qs": "^6.16.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
