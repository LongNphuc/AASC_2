# Mẫu .env (readme_run.md bước 2). Giá trị trỏ sẵn tới mock: chạy ngay bằng
#   cp .env.example .env && docker compose up -d --build
# Chạy ngoài Docker (cách B): đổi các địa chỉ db, redis, mock sang localhost.

NODE_ENV=development
PORT=3000
# Để trống khi chạy local (API mở, có cảnh báo); đặt khi chạy trên server.
API_KEY=
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Docker tự đặt hai biến này (docker-compose.yml). Ngoài Docker:
DATABASE_URL=postgres://app:app@localhost:5432/tiktok_bitrix
REDIS_URL=redis://localhost:6379
# true: api chạy migration khi khởi động; false khi chạy migration riêng (readme_run.md bước 8).
DB_MIGRATIONS_RUN=true

# --- TikTok ---
# Khóa ký webhook; script npm run tiktok:send dùng cùng khóa.
TIKTOK_WEBHOOK_SECRET=dev-tiktok-secret
TIKTOK_SIGNATURE_TOLERANCE_SECONDS=300
FORM_COMPLETE_WINDOW_HOURS=24
# Events API (báo conversion). Mock: http://mock:4000, nhận token bất kỳ.
TIKTOK_API_BASE_URL=http://mock:4000
TIKTOK_ACCESS_TOKEN=mock-access-token
TIKTOK_CRM_EVENT_SET_ID=mock-crm-event-set
TIKTOK_EVENT_DEAL_CREATED=lead_qualified
TIKTOK_EVENT_DEAL_WON=deal_won

# --- Bitrix24 ---
# Webhook vào. Portal thật: https://<portal>.bitrix24.vn/rest/1/<mã>/ (readme_run.md bước 1.2).
BITRIX24_WEBHOOK_URL=http://mock:4000/rest/1/mocktoken
# Mã xác thực (application_token) của webhook đi; mock dùng cùng giá trị khi gọi về.
BITRIX24_OUTBOUND_TOKEN=dev-bitrix-outbound-token
# Giới hạn gọi Bitrix24 chung cho mọi process.
BITRIX24_MAX_RPS=2
BITRIX24_BURST=10
BITRIX24_LEAD_SOURCE_ID=TIKTOK
BITRIX24_SOURCES_FIELD=UF_CRM_SOURCES

PHONE_DEFAULT_REGION=VN
DEFAULT_CURRENCY=VND

# --- Hàng đợi, job ---
# 1 lần + 3 lần thử lại, cách nhau 2, 4, 8 giây.
JOB_ATTEMPTS=4
JOB_BACKOFF_MS=2000
RECOVERY_CRON=*/10 * * * *
RECOVERY_MAX_ROUNDS=3
REPORT_DAILY_CRON=0 8 * * *
ALERT_CHECK_CRON=*/15 * * * *
WORKER_HEARTBEAT_SECONDS=10
WORKER_STALE_SECONDS=30

# --- Thông báo (ID người dùng Bitrix24, cách nhau dấu phẩy) ---
NOTIFY_ADMIN_USER_IDS=1
NOTIFY_HOT_LEAD_USER_IDS=1
HOT_LEAD_SCORE=80

# --- Giới hạn tốc độ API, cache ---
THROTTLE_API_LIMIT=100
THROTTLE_EXPORT_LIMIT=5
THROTTLE_WEBHOOK_LIMIT=600
THROTTLE_TTL_SECONDS=60
CACHE_TTL_CONFIG_SECONDS=300
CACHE_TTL_ANALYTICS_SECONDS=30

HTTP_TIMEOUT_MS=15000
LOG_DIR=logs
LOG_LEVEL=info

# --- Process mock ---
MOCK_PORT=4000
MOCK_APP_WEBHOOK_URL=http://api:3000/webhooks/bitrix24/deals
