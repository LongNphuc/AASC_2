    "/api/v1/reports/{uuid}": {
      "get": {
        "description": "Chỉ số theo campaign của hôm qua và 7 ngày gần nhất.",
        "operationId": "ReportsController_detail",
        "parameters": [
          {
            "name": "uuid",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Một báo cáo",
        "tags": [
          "Báo cáo"
        ]
      }
    },
    "/api/v1/alerts": {
      "get": {
        "description": "Lọc theo loại và khoảng thời gian.",
        "operationId": "AlertsController_list",
        "parameters": [
          {
            "name": "date_range",
            "required": false,
            "in": "query",
            "schema": {
              "default": "30d",
              "type": "string",
              "enum": [
                "7d",
                "30d",
                "90d"
              ]
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "schema": {
              "example": "2026-10-01",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "schema": {
              "example": "2026-10-21",
              "type": "string"
            }
          },
          {
            "name": "type",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "cpl_high",
                "conversion_drop",
                "dlq_not_empty",
                "sync_failed",
                "worker_down"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Cảnh báo",
        "tags": [
          "Thống kê"
        ]
      }
    },
    "/api/v1/ops/queues": {
      "get": {
        "description": "Số job chờ, đang chạy, trễ, lỗi (failed = dead letter queue) của crm-pipeline và maintenance.",
        "operationId": "OpsController_queues",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Hàng đợi",
        "tags": [
          "Vận hành"
        ]
      }
    },
    "/api/v1/ops/dead-letters": {
      "get": {
        "description": "Sự kiện đang FAILED trong DB: bước chết, mã lỗi, số lần chạy, số vòng recovery đã chạy lại, kèm trạng thái job trong BullMQ. retryable false: lỗi không thử lại được, sửa nguyên nhân rồi chạy lại tay.",
        "operationId": "OpsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Dead letter queue",
        "tags": [
          "Vận hành"
        ]
      }
    },
    "/api/v1/ops/recovery/run": {
      "post": {
        "description": "Không tham số: chạy lại sự kiện FAILED vì lỗi tạm thời và sự kiện mất job, còn dưới RECOVERY_MAX_ROUNDS vòng, không chờ 5/30 phút. webhook_event_uuid: chạy lại đúng sự kiện đó, kể cả đã đủ vòng hoặc lỗi không thử lại được (retry_count về 0).",
        "operationId": "OpsController_runRecovery",
        "parameters": [
          {
            "name": "webhook_event_uuid",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": ""
          }
        },
        "summary": "Chạy batch recovery ngay",
        "tags": [
          "Vận hành"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "database, redis down thì 503. worker (nhịp tim cũ), bitrix24 (chế độ CRM đơn giản) down thì status \"degraded\" nhưng vẫn 200. queues chỉ báo số job.",
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ],
                      "example": "ok"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {},
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "error",
                        "shutting_down"
                      ],
                      "example": "error"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Health check",
        "tags": [
          "Health"
        ]
      }
    }
  },
  "info": {
    "title": "TikTok Lead Generation → Bitrix24 CRM",
    "description": "Nhận lead TikTok qua webhook, đồng bộ lên Bitrix24, chuyển thành deal theo rule, thống kê. Khi đặt API_KEY, mọi /api/v1/* cần header x-api-key. Mã lỗi errorKbn: chữ số đầu là nơi lỗi (2 dữ liệu/cấu hình, 3 TikTok, 4 Bitrix24, 6 job, 9 ứng dụng).",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "SaveMappingDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "description": "Phiên bản đang sửa, lấy từ GET",
            "example": 1
          },
          "updated_at": {
            "type": "object",
            "readOnly": true
          },
          "field_mapping": {
            "type": "object",
            "example": {
              "lead_data.full_name": "NAME",
              "lead_data.email": "EMAIL[0][VALUE]",
              "lead_data.phone": "PHONE[0][VALUE]",
              "lead_data.city": "UF_CRM_CITY"
            }
          },
          "supported_paths": {
            "type": "object",
            "readOnly": true
          },
          "reserved_fields": {
            "type": "object",
            "readOnly": true
          }
        },
        "required": [
          "version",
          "field_mapping"
        ]
      },
      "SaveRulesDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "description": "Phiên bản đang sửa, lấy từ GET",
            "example": 1
          },
          "updated_at": {
            "type": "object",
            "readOnly": true
          },
          "deal_rules": {
            "example": [
              {
                "condition": "campaign.campaign_name CONTAINS 'sale'",
                "action": "create_deal",
                "pipeline_id": "1",
                "stage_id": "NEW",
                "probability": 30
              }
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stage_probability": {
            "type": "object",
            "example": {
              "1": {
                "NEW": 30,
                "PREPARATION": 50,
                "WON": 100,
                "LOSE": 0
              }
            }
          },
          "assignment_rules": {
            "example": [
              {
                "condition": "lead_data.city = 'Hà Nội'",
                "user_ids": [
                  7,
                  9
                ]
              },
              {
                "condition": "*",
                "user_ids": [
                  12
                ]
              }
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "version",
          "deal_rules",
          "stage_probability",
          "assignment_rules"
        ]
      },
      "SaveAlertsDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "description": "Phiên bản đang sửa, lấy từ GET",
            "example": 1
          },
          "updated_at": {
            "type": "object",
            "readOnly": true
          },
          "alert_rules": {
            "type": "object",
            "example": {
              "cpl_max": 80000,
              "conversion_drop_percent": 30,
              "min_leads": 20
            }
          }
        },
        "required": [
          "version",
          "alert_rules"
        ]
      },
      "ConvertToDealDto": {
        "type": "object",
        "properties": {
          "lead_submission_uuid": {
            "type": "string",
            "description": "Mặc định: lượt gửi mới nhất chưa có deal"
          },
          "pipeline_id": {
            "type": "string",
            "example": "1"
          },
          "stage_id": {
            "type": "string",
            "example": "NEW"
          },
          "probability": {
            "type": "number",
            "example": 50
          },
          "amount": {
            "type": "number",
            "example": 10000000
          },
          "assigned_to": {
            "type": "number",
            "example": 9
          }
        }
      }
    }
  },
  "security": [
    {
      "api-key": []
    }
  ]
}
