            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Lưu rule",
        "tags": [
          "Cấu hình"
        ]
      }
    },
    "/api/v1/config/alerts": {
      "get": {
        "description": "cpl_max, conversion_drop_percent, min_leads.",
        "operationId": "ConfigController_getAlerts",
