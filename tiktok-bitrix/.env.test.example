# Mẫu .env.test cho integration và E2E test (readme_run.md bước 7):
#   cp .env.test.example .env.test
#   docker compose --profile test up -d db-test redis-test
NODE_ENV=test
DATABASE_URL=postgres://app:app@localhost:5433/tiktok_bitrix_test
REDIS_URL=redis://localhost:6380
TIKTOK_WEBHOOK_SECRET=test-tiktok-secret
TIKTOK_API_BASE_URL=http://127.0.0.1:4999
TIKTOK_ACCESS_TOKEN=test-access-token
TIKTOK_CRM_EVENT_SET_ID=test-crm-event-set
BITRIX24_WEBHOOK_URL=http://127.0.0.1:4999/rest/1/testtoken
BITRIX24_OUTBOUND_TOKEN=test-bitrix-outbound-token
# Test không phải chờ limiter và backoff thật.
BITRIX24_MAX_RPS=1000
BITRIX24_BURST=1000
JOB_BACKOFF_MS=10
LOG_DIR=logs/test
LOG_LEVEL=error
