# ===== Ứng dụng =====
# Cổng HTTP
PORT=3000
# Khóa bảo vệ API (header x-api-key). Để trống khi chạy trên máy local / demo: API và admin panel
# không cần khóa. Chạy trên server thì đặt, tạo bằng: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
API_KEY=
# PostgreSQL 18+. Docker Compose tự đặt; chạy bằng Node.js thì dùng giá trị dưới
DATABASE_URL=postgres://sync:sync@localhost:5432/gg_sheets_bitrix

# ===== Google Sheets =====
# service_account (khuyên dùng) hoặc oauth
GOOGLE_AUTH_MODE=service_account
# Tệp khóa JSON của service account (thư mục secrets/ không commit)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
# Chỉ dùng khi GOOGLE_AUTH_MODE=oauth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/google/oauth/callback
# Đoạn giữa /d/ và /edit trong URL của Sheet
GOOGLE_SPREADSHEET_ID=
# Tên tab, đúng cả hoa/thường
GOOGLE_SHEET_NAME=

# ===== Bitrix24 =====
# Webhook vào, dạng https://<portal>/rest/<user_id>/<mã>/ (quyền crm, user). Đây là bí mật
BITRIX24_WEBHOOK_URL=
# Số request/giây tối đa tới Bitrix24
BITRIX24_MAX_RPS=2
# Đồng bộ hai chiều: mã application_token của webhook đi trên Bitrix24 (gọi vào /webhooks/bitrix24). Đây là bí mật
BITRIX24_OUTBOUND_TOKEN=

# ===== Đồng bộ =====
# Mapping ban đầu, nạp vào DB khi chưa có mapping nào
MAPPING_FILE=mapping.json
# sheet_to_bitrix: một chiều. both: thêm chiều Bitrix24 → Sheet cho các cột "owner": "bitrix" trong mapping,
# chạy ngay khi Bitrix24 gọi webhook (cần BITRIX24_OUTBOUND_TOKEN và tên miền công khai, ví dụ ngrok)
SYNC_DIRECTION=sheet_to_bitrix
# Chu kỳ chạy tự động (giây): lần kế tiếp = lúc lần trước xong + chu kỳ. 900 = 15 phút, 3600 = 1 giờ
SYNC_INTERVAL_SECONDS=900
# Chu kỳ batch làm mới token Google (giây, tối đa 3000 vì token sống 3600 giây)
GOOGLE_TOKEN_REFRESH_SECONDS=1800
# Múi giờ ghi vào cột "Thời gian đồng bộ cuối"
SYNC_TIMEZONE=Asia/Ho_Chi_Minh
# Thời gian tối đa gửi lên Bitrix24 trong một lần chạy
SYNC_MAX_RUN_SECONDS=600
# Nhịp tim của lần chạy, và ngưỡng coi lần chạy đã chết
SYNC_HEARTBEAT_SECONDS=30
SYNC_STALE_SECONDS=120
# Thử lại: số lần, thời gian chờ đầu (ms); API bắt chờ quá N giây thì ghi cooldown thay vì chờ
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_INLINE_WAIT_SECONDS=10
# Số batch Bitrix24 lỗi liên tiếp thì dừng gửi
PUSH_MAX_CONSECUTIVE_FAILURES=2

# ===== Khác =====
# Thời gian chờ mỗi lệnh gọi ra ngoài (ms)
HTTP_TIMEOUT_MS=30000
LOG_DIR=logs
